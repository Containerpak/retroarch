{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "RetroArch",
  "description": "Run emulators, game engines and media cores.",
  "version": "1.22.2",
  "image": "ghcr.io/containerpak/retroarch@sha256:42a65911a3250b7d621acc5b4014c31b858427ddbbba5ec246b873089f06bcf5",
  "binaries": [
    "/usr/bin/retroarch"
  ],
  "desktop_entries": [
    "/usr/share/applications/com.libretro.RetroArch.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": true,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
